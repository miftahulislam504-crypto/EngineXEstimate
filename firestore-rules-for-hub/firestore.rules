rules_version = '2';

// ════════════════════════════════════════════════════════════════
// CivilOS Ecosystem — Unified Firestore Security Rules
// Single Firebase project shared by:
//   1. CivilOS Hub             (projects, users, activity_logs, ...)
//   2. CivilOS Structural       (projects/{id} full design doc)
//   3. CivilOS Architectural    (drawings, projects/{id}/* bridge data)
//   4. CivilOS Estimating       (uses ecosystem bridge)
//   5. CivilOS Project Mgmt     (activities, tasks, issues, ...)
//   6. CivilOS Report & Export  (reports, templates, packages, ...)
//
// Model: any signed-in account (your team's Firebase Auth users)
// has full read/write access to the shared workspace, EXCEPT for a
// small set of financial-approval paths used by CivilOS Estimating
// (Module 10 Budget Planning, Module 12 Tender Estimation) which
// require estimatingRole == 'admin' on the users/{uid} document.
// Anonymous / unauthenticated access is always denied.
//
// ── পরিবর্তনের ইতিহাস ──────────────────────────────────────────
// [তারিখ যোগ করুন] — CivilOS Estimating app-এর জন্য admin-only
// financial-write rule যোগ করা হলো (budgetApproval, tenderFinalize
// subcollection)। বাকি সব কিছু Hub-এর মূল rules-এর সাথে অপরিবর্তিত।
// এই ফাইলটা Hub-এর deploy pipeline-এর অংশ (DEPLOYMENT.md অনুযায়ী
// Firebase Console-এ paste করা হয়) — Hub থেকে rules পুনরায় deploy
// করলে এই পরিবর্তন হারিয়ে যেতে পারে, তাই Hub-এর দিক থেকেও এই ফাইলটা
// আপডেট রাখা দরকার।
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // CivilOS Estimating app-এর admin check। users/{uid}.estimatingRole
    // পড়ে দেখে — এই ফিল্ড Hub-এর "role" ফিল্ড থেকে ইচ্ছাকৃতভাবে আলাদা
    // (lib/types/auth.types.ts-এ বিস্তারিত কারণ আছে)। get() একটা
    // অতিরিক্ত read খরচ করে প্রতিটা financial write-এ, কিন্তু এই
    // পাথগুলোতে write কম ঘন ঘন হয় (budget approve, tender finalize)
    // বলে এই খরচ গ্রহণযোগ্য।
    function isEstimatingAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.estimatingRole == 'admin';
    }

    // ──────────────────────────────────────────────────────────
    // USERS — CivilOS Hub profile (uid, email, displayName, role,
    // estimatingRole)
    // Anyone signed in can read team profiles, but a user can
    // only create/update/delete their OWN profile document.
    // ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────────────────
    // PROJECTS — shared master record used by every app.
    // The wildcard below covers ALL nested subcollections that
    // the apps read/write for cross-app sync, e.g.:
    //   activity_logs, site_information, bnbc_settings,
    //   building_information, documents, structuralInput,
    //   estimatingInput, architecturalStatus, architecturalSummary,
    //   structuralGrid, schedules, bnbcReport, boq/{floorId}, etc.
    //
    // ব্যতিক্রম: budgetApproval ও tenderFinalize subcollection-এ
    // write করতে estimatingRole == 'admin' লাগবে (নিচে আলাদা match
    // ব্লকে সংজ্ঞায়িত, কারণ Firestore rules-এ বেশি নির্দিষ্ট
    // match সাধারণ wildcard-এর চেয়ে অগ্রাধিকার পায় না — তাই
    // wildcard ব্লক থেকে এই দুইটা পাথ explicitly বাদ দিতে হয়েছে)।
    // ──────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read, write: if isSignedIn();

      // Module 10 — Budget Planning: Approved Cost সেট করা admin-only
      match /budgetApproval/{docId} {
        allow read:  if isSignedIn();
        allow write: if isEstimatingAdmin();
      }

      // Module 12 — Tender Estimation: Comparative Statement
      // finalize করা admin-only
      match /tenderFinalize/{docId} {
        allow read:  if isSignedIn();
        allow write: if isEstimatingAdmin();
      }

      // বাকি সব subcollection — আগের মতোই যেকোনো signed-in user
      // read/write করতে পারবে (estimatingInput, structuralInput,
      // ইত্যাদি সব এখানেই পড়ে)
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ──────────────────────────────────────────────────────────
    // DRAWINGS — CivilOS Architectural canvas data
    //   drawings/{projectId}/floors/{floorId}
    //   drawings/{projectId}/structuralGrid/data
    // ──────────────────────────────────────────────────────────
    match /drawings/{projectId} {
      allow read, write: if isSignedIn();

      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ──────────────────────────────────────────────────────────
    // ESTIMATING APP — organization-wide shared data (প্রজেক্ট-নির্দিষ্ট
    // না, তাই projects/{projectId}-এর নিচে না রেখে top-level collection)
    //
    // materials      — Module 5 (Material Database) + Module 6
    //                  (Market Rate Update)। priceHistory subcollection
    //                  সহ, একই rule wildcard দিয়ে কভার হয়।
    // suppliers      — Module 9 (Vendor Management)। এখনো কোনো কোড
    //                  লেখা হয়নি, কিন্তু materials-এর সাথে conceptually
    //                  সংযুক্ত (Material.defaultSupplierId রেফারেন্স
    //                  করে) বলে rule আগেভাগে যোগ করে রাখা হলো।
    // resourceRates  — Module 4 (Rate Analysis)-এর Labour ও Equipment
    //                  rate, materials-এর মতোই সাংগঠনিক-স্তরে শেয়ার্ড।
    //                  rateHistory subcollection একই wildcard দিয়ে কভার।
    // ──────────────────────────────────────────────────────────
    match /materials/{materialId} {
      allow read, write: if isSignedIn();

      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }

    match /resourceRates/{rateId} {
      allow read, write: if isSignedIn();

      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ──────────────────────────────────────────────────────────
    // REPORT & EXPORT app
    // ──────────────────────────────────────────────────────────
    match /reports/{reportId}           { allow read, write: if isSignedIn(); }
    match /reportTemplates/{templateId} { allow read, write: if isSignedIn(); }
    match /documentPackages/{packageId} { allow read, write: if isSignedIn(); }
    match /revisions/{revisionId}       { allow read, write: if isSignedIn(); }
    match /exports/{exportId}           { allow read, write: if isSignedIn(); }

    // Ecosystem bridge: civilos_bridge/{projectId}_{sourceApp}
    match /civilos_bridge/{bridgeDocId} { allow read, write: if isSignedIn(); }

    // ──────────────────────────────────────────────────────────
    // PROJECT MANAGEMENT app
    // ──────────────────────────────────────────────────────────
    match /activities/{id}        { allow read, write: if isSignedIn(); }
    match /tasks/{id}              { allow read, write: if isSignedIn(); }
    match /procurement/{id}        { allow read, write: if isSignedIn(); }
    match /handover_items/{id}     { allow read, write: if isSignedIn(); }
    match /punch_list/{id}         { allow read, write: if isSignedIn(); }
    match /final_inspections/{id}  { allow read, write: if isSignedIn(); }
    match /cost_entries/{id}       { allow read, write: if isSignedIn(); }
    match /site_diary/{id}         { allow read, write: if isSignedIn(); }
    match /issues/{id}             { allow read, write: if isSignedIn(); }
    match /risks/{id}              { allow read, write: if isSignedIn(); }
    match /qc_records/{id}         { allow read, write: if isSignedIn(); }
    match /approvals/{id}          { allow read, write: if isSignedIn(); }
    match /progress_updates/{id}   { allow read, write: if isSignedIn(); }
    match /notifications/{id}      { allow read, write: if isSignedIn(); }

    // ──────────────────────────────────────────────────────────
    // Default deny — anything not explicitly listed above
    // ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
